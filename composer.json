{
  "name": "rodrigopedra/laravel-query-logger",
  "description": "Laravel query logger",
  "keywords": [
    "query logger",
    "rodrigopedra",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Rodrigo Pedra Brum",
      "email": "rodrigo.pedra@gmail.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "psr/log": "^2|^3"
  },
  "autoload": {
    "psr-4": {
      "RodrigoPedra\\QueryLogger\\": "src/QueryLogger/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "RodrigoPedra\\QueryLogger\\QueryLoggerServiceProvider"
      ]
    }
  }
}
